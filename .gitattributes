# Normaliza todos os arquivos de texto para LF no repositório
* text=auto eol=lf

# Texto explícito
*.html text eol=lf
*.css  text eol=lf
*.js   text eol=lf
*.json text eol=lf
*.svg  text eol=lf
*.md   text eol=lf

# Windows-specific (mantém CRLF)
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Binários (sem conversão)
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.woff binary
*.woff2 binary
*.pdf  binary
