# Texto autoral normalizado para LF
* text=auto eol=lf
*.html text eol=lf
*.css text eol=lf
*.json text eol=lf
*.svg text eol=lf
*.md text eol=lf
*.txt text eol=lf

# Recursos binários
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.pdf binary

# Preserva os bytes e a formatação das cópias oficiais
docs/referencias/europass/fontes/*.html -text -whitespace
